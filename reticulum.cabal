cabal-version:   3.0
name:            reticulum
version:         0.1.0
synopsis:        A Reticulum node
author:          Leonhard Weiler
license:         LicenseRef-Reticulum
license-file:    LICENSE
build-type:      Simple
extra-doc-files: README, CLAUDE.md, CORPUS, DEPENDS

common strict
    default-language: Haskell2010
    ghc-options:      -Wall -Werror -Wincomplete-uni-patterns

library
    import:          strict
    hs-source-dirs:  src
    exposed-modules: Reticulum.Announce
                     Reticulum.Bytes
                     Reticulum.Channel
                     Reticulum.Destination
                     Reticulum.Encryption
                     Reticulum.Identity
                     Reticulum.Interface
                     Reticulum.Interface.Hdlc
                     Reticulum.Interface.Tcp
                     Reticulum.Link
                     Reticulum.Msgpack
                     Reticulum.Node
                     Reticulum.Node.State
                     Reticulum.Node.Transfer
                     Reticulum.Packet
                     Reticulum.Path
                     Reticulum.Proof
                     Reticulum.Rejection
                     Reticulum.Request
                     Reticulum.Resource
                     Reticulum.Token
                     Reticulum.Transport
    build-depends:   base        >=4.17 && <5
                   , bytestring
                   , bzlib
                   , containers
                   , crypton
                   , memory
                   , network
                   , stm
                   , time

executable harness
    import:         strict
    hs-source-dirs: cmd/harness
    main-is:        Main.hs
    build-depends:  base
                  , bytestring
                  , memory
                  , reticulum

executable node
    import:         strict
    hs-source-dirs: cmd/node
    main-is:        Main.hs
    build-depends:  base
                  , bytestring
                  , containers
                  , memory
                  , reticulum

test-suite test
    import:         strict
    type:           exitcode-stdio-1.0
    hs-source-dirs: test
    main-is:        Main.hs
    build-depends:  base
                  , bytestring
                  , bzlib
                  , containers
                  , reticulum
